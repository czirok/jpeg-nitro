 {
     plutovg_surface_t* surface = plutovg_surface_create_uninitialized(width, height);
     if(surface)
-        memset(surface->data, 0, surface->height * surface->stride);
+        memset(surface->data, 0, (size_t)surface->height * surface->stride);
     return surface;
 }
 
